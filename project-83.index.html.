<script>
(function(){
  var gate=document.getElementById('gate'),
      lock=document.getElementById('lock'),
      site=document.getElementById('site'),
      nav=document.getElementById('nav'),
      foot=document.getElementById('foot'),
      reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- puerta ---- */
  document.getElementById('doorIn').addEventListener('click',function(){
    gate.classList.add('gate--gone');
    document.body.classList.remove('locked');
    site.removeAttribute('aria-hidden');
    nav.removeAttribute('aria-hidden');
    foot.removeAttribute('aria-hidden');
    site.classList.add('on'); nav.classList.add('on'); foot.classList.add('on');
    setTimeout(function(){ gate.style.display='none'; observe(); },reduce?0:650);
  });

  document.getElementById('doorOut').addEventListener('click',function(){
    lock.hidden=false;
    document.getElementById('lie').focus();
  });

  document.getElementById('lie').addEventListener('click',function(){
    lock.hidden=true;
    document.getElementById('doorIn').focus();
  });

  /* ---- revelado al scroll ---- */
  function observe(){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    },{threshold:.15,rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.rev,.gauge,.stock').forEach(function(el){ io.observe(el); });
  }

  /* ---- cuenta regresiva: día 17 a las 20:17 ---- */
  var target=(function(){
    var n=new Date(), t=new Date(n.getFullYear(),n.getMonth(),17,20,17,0,0);
    if(t<=n){ t=new Date(n.getFullYear(),n.getMonth()+1,17,20,17,0,0); }
    return t;
  })();

  var meses=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  document.getElementById('dropDate').textContent='17 '+meses[target.getMonth()]+' · 20:17';

  function pad(n){ return (n<10?'0':'')+n; }
  function tick(){
    var ms=target-new Date();
    if(ms<0) ms=0;
    var s=Math.floor(ms/1000);
    document.getElementById('cd').textContent=pad(Math.floor(s/86400));
    document.getElementById('ch').textContent=pad(Math.floor(s%86400/3600));
    document.getElementById('cm').textContent=pad(Math.floor(s%3600/60));
    document.getElementById('cs').textContent=pad(s%60);
  }
  tick(); setInterval(tick,1000);

  /* ---- etiqueta ---- */
  var tag=document.getElementById('tag');
  tag.addEventListener('click',function(){ tag.classList.toggle('flip'); });

  /* ---- lista ---- */
  var mail=document.getElementById('mail'),
      msg=document.getElementById('msg'),
      formBlock=document.getElementById('formBlock'),
      done=document.getElementById('done');

  function join(){
    var v=mail.value.trim();
    if(!v){ msg.className='form-msg form-msg--err'; msg.textContent='Falta el correo. Escríbelo para reservar tu turno.'; mail.focus(); return; }
    if(!/^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(v)){ msg.className='form-msg form-msg--err'; msg.textContent='Ese correo está incompleto. Revisa que tenga @ y dominio.'; mail.focus(); return; }
    formBlock.hidden=true;
    done.hidden=false;
  }
  document.getElementById('join').addEventListener('click',join);
  mail.addEventListener('keydown',function(e){ if(e.key==='Enter') join(); });
})();
</script>
